# Generated build/output directories
build/
out/
dist/
bin/
obj/
.cache/
__pycache__/
*.py[cod]

# Never track private proprietary inputs from local reference environments
private/
local/
reference/
test-data-private/
.env
.env.*

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Intentionally do NOT blanket-ignore .cue, .iso, .bin, .rom or .wav:
# independently authored synthetic ROM/CD fixtures need to be reviewable.
# Git ignores are not a provenance gate; enforce allowed paths, content
# reviews and release restrictions through Issue #8.
