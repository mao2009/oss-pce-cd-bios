+// hardware for the instruction's cycles before it stops (device time advances; no CPU access is made).
+extern bool (*gg_verify_stack_guard)(void* context, unsigned op, unsigned s, unsigned transfer_state, bool latched);
+extern void (*gg_verify_io_observer)(void* context, unsigned is_write, unsigned address, unsigned value);
