+INLINE bool GG_VerifyStackAllowed(unsigned op, unsigned s, unsigned transfer_state)
+{
+    if (!gg_verify_stack_guard)
+        return true;
+    bool latched = gg_verify_stack_refused;
+    bool allowed = gg_verify_stack_guard(gg_verify_stack_context, op, s, transfer_state, latched) && !latched;
