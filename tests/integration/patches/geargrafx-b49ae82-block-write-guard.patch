+// VERIFICATION-ONLY pre-write guard for TII/TIN/TIA/TDD/TAI byte stores (Issue #367 / #173).
+// NOT upstream code. Null hook = upstream behaviour. block_op: 0=TII 1=TIN 2=TIA 3=TDD 4=TAI.
+// Defined in huc6280_opcodes.cpp. The guard runs BEFORE the byte read and Memory::Write.
+extern bool (*gg_verify_block_write_guard)(void* context, unsigned block_op, unsigned dest);
+extern bool (*gg_verify_transfer_start_guard)(void* context, unsigned stack_pointer);
+extern bool (*gg_verify_transfer_abort_guard)(void* context, unsigned block_op,
+                                              unsigned source, unsigned dest, unsigned length);
+extern void (*gg_verify_block_byte_observer)(void* context, unsigned block_op,
+                                              unsigned source, unsigned dest);
+extern void* gg_verify_block_write_context;
+
+// VERIFICATION-ONLY pre-push guard for TransferStart A/X/Y stack pushes (Issue #459 / #367 / #173).
+// Null hook = upstream behaviour. stack_pointer = S before the three pushes (page 1 holds $2100|S).
+INLINE bool GG_VerifyTransferStart_Allowed(unsigned stack_pointer)
+{
+    return !gg_verify_transfer_start_guard || gg_verify_transfer_start_guard(gg_verify_block_write_context, stack_pointer);
+}
+
+INLINE bool GG_VerifyBlockWrite_Allowed(unsigned block_op, unsigned dest)
+{
+    return !gg_verify_block_write_guard || gg_verify_block_write_guard(gg_verify_block_write_context, block_op, dest);
+}
+
+// VERIFICATION-ONLY safe preflight: operands are peeked without bus reads, and
+// only from ordinary WRAM banks. Any unpeekable/MMIO/code-mapped case fails closed.
+INLINE bool GG_VerifyTransferPreflight_Allowed(Memory* memory, u16 operand_pc, unsigned block_op)
+{
+    if (!gg_verify_transfer_abort_guard)
+        return true;
+    u8 operand[6];
+    for (unsigned i = 0; i < 6; ++i) {
+        u16 address = (u16)(operand_pc + i);
+        u8 bank = memory->GetMpr((u8)(address >> 13));
+        if (memory->GetBankType(bank) != Memory::MEMORY_BANK_TYPE_WRAM ||
+            !memory->TryPeek(address, &operand[i]))
+            return false;
+    }
+    unsigned source = operand[0] | (operand[1] << 8);
+    unsigned dest = operand[2] | (operand[3] << 8);
+    unsigned length = operand[4] | (operand[5] << 8);
+    return gg_verify_transfer_abort_guard(gg_verify_block_write_context, block_op, source, dest, length);
+}
+
+INLINE void GG_ObserveBlockByte(unsigned block_op, unsigned source, unsigned dest)
+{
+    if (gg_verify_block_byte_observer)
+        gg_verify_block_byte_observer(gg_verify_block_write_context, block_op, source, dest);
+}
