     m_S.Decrement();
+    if (gg_verify_stack_mutation == 1 && !GG_VerifyStackAllowed(1, m_S.GetValue(), m_transfer_state))
+    {
+        GG_VERIFY_STACK_STOP();
+        return;
+    }
     m_memory->Write(STACK_ADDR | m_S.GetValue(), static_cast<u8>(value & 0x00FF));
     m_S.Decrement();
 }
 
